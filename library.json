{
  "name": "microLXMF",
  "version": "0.1.0",
  "description": "C++ implementation of LXMF (Lightweight Extensible Message Format) layered on attermann/microReticulum. Sister library to LXMF-swift / LXMF-kt. Suitable for ESP32 and host (POSIX) targets.",
  "keywords": "lxmf, reticulum, messaging, esp32, embedded",
  "repository": {
    "type": "git",
    "url": "https://github.com/torlando-tech/microLXMF.git"
  },
  "authors": [
    {
      "name": "Torlando Tech LLC",
      "url": "https://github.com/torlando-tech",
      "maintainer": true
    }
  ],
  "license": "GPL-3.0-only",
  "frameworks": ["arduino", "*"],
  "platforms": "*",
  "dependencies": [
    {
      "name": "microReticulum",
      "version": "*"
    },
    {
      "name": "ArduinoJson",
      "version": "^7.4.2"
    }
  ],
  "build": {
    "srcDir": "src",
    "includeDir": "src",
    "flags": [
      "-Isrc"
    ]
  },
  "export": {
    "exclude": [
      ".pio",
      "build",
      "conformance-bridge/build"
    ]
  }
}
